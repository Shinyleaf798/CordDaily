// 完整字段设计见 docs/PROJECT-PLAN.md 第2节，改结构前先改那份文档

generator client {
  provider = "prisma-client-js"
}

// 连接串不再放这里，见 backend/prisma.config.ts（CLI）和 src/config/prisma.js（运行时 adapter）
datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AccountType {
  CASH
  BANK
  EWALLET
  CREDIT_CARD
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  baseCurrency String   @default("MYR")
  createdAt    DateTime @default(now())

  // 账号头像。图直接存这一行里（一个账号只有一张，为它单开一张表是纯开销），
  // 手机端那边同一张图存在沙盒文件里，只有备份时才 base64 推上来。
  // 这是唯一一处二进制进库的地方——分类图标走的是 CategoryIcon 表
  avatar     Bytes?
  avatarMime String?

  categories            Category[]
  categoryIcons         CategoryIcon[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  accounts              Account[]
  transfers             Transfer[]
}

/// 主键是 `(userId, id)` 而不是全局唯一的 `id`：13 个内置分类的 UUID 写死在手机端的
/// `constants/default-categories.ts` 里，**每个用户都会有同一批 id**（那是"重装后恢复备份
/// 不用改写 categoryId"的地基，见 CLAUDE.md 原则#2）。全局主键装不下第二个用户的那 13 行。
///
/// 于是所有指向分类的外键都得带上 userId 一起指。`Transaction` / `RecurringTransaction`
/// 本来就有 userId，不用加列。
model Category {
  id     String
  name   String
  icon   String?
  type   TransactionType
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Category?  @relation("SubCategory", fields: [userId, parentId], references: [userId, id])
  children Category[] @relation("SubCategory")

  @@id([userId, id])

  /// 在记账页分类网格里的先后。同一层（同一个 parentId）内部比较，手机端拖动排序时改它。
  /// 目前只有一级分类拖得动，子分类一律跟着创建顺序——列给全了，以后想开子分类排序不用再迁移
  sortOrder Int @default(0)

  /// false = 停用。分类被账单引用着就删不掉（下面那两个关系是默认的 Restrict），
  /// 停用是它唯一的出路：从记账页的网格里收起来，历史账单和统计一个字都不变
  isActive Boolean @default(true)

  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
}

/// 主键跟 Category 同理：两个内置账户（「不选择任何账户」和「现金」）的 id 也是常量，
/// 所有用户共用同一对 UUID
model Account {
  id             String
  name           String
  type           AccountType
  currency       String      @default("MYR")
  openingBalance Decimal     @default(0)
  icon           String?
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@id([userId, id])

  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  transfersOut          Transfer[]              @relation("FromAccount")
  transfersIn           Transfer[]              @relation("ToAccount")
}

// 录入的四个文字字段各管一个维度：title=为了什么事、merchant=在哪家、remarks=具体买了啥、location=在哪一带。
// merchant/location 可复用（会被反复输入同样的值），但故意不拆成独立表——
// 建表意味着多一个同步端点和"商家必须先于交易插入"的顺序依赖，而补全和 GROUP BY 统计客户端一条 SQL 就够了
model Transaction {
  id               String          @id // 客户端生成的UUID，不用 @default(uuid())
  title            String
  merchant         String?
  location         String?
  remarks          String?
  amount           Decimal
  currency         String          @default("MYR")
  exchangeRate     Decimal         @default(1)
  amountInBase     Decimal
  type             TransactionType
  date             DateTime
  tags             String[]        @default([])
  isReimbursable   Boolean         @default(false)
  reimbursedAt     DateTime? // null=待报销，有值=已收回
  excludeFromStats Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // 分类和账户的外键都带上 userId：那两张表的主键是 (userId, id) 复合键（见 Category 上的说明）
  categoryId String
  category   Category @relation(fields: [userId, categoryId], references: [userId, id])
  accountId  String
  account    Account  @relation(fields: [userId, accountId], references: [userId, id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id])

  images TransactionImage[]

  // 手机端的远端建表语句（mobile/src/db/neon/schema.ts）已经在建这两个索引了，
  // 名字跟 Prisma 的命名约定一致。这里补上声明，两边才对得上——
  // 不声明的话 Prisma 每次 `migrate dev` 都会把它们当成"库被别人改过"
  @@index([userId, date])
  @@index([userId, categoryId])
}

/// 用户自己上传的分类图标，**二进制真的存在这张表里**（bytea），不走图床。
///
/// 这是对「图片只存网址、后端不碰二进制」（CLAUDE.md 原则#6）的一次**有意破例**，
/// 范围只限分类图标：手机端在存进沙盒之前已经把它缩到长边 192px / JPEG，单张 10–20 KB，
/// 张数是"用户手动挑过几次图"这个量级（个位数），整个用户加起来还没有他一个月的账单行大。
/// 为这点数据去接一个图床，要多一套凭证、多一个会过期的外部依赖、多一条删不干净的清理链。
/// 账单收据照片不在此列——那是张数无上限、单张 MB 级的东西，仍然走 Cloudinary（见 TransactionImage）。
///
/// 主键是 `(userId, name)`：`name` 就是手机端生成的文件名（UUID.jpg），也是本地
/// `categories.icon` 里 `custom:` 后面那一段。按用户隔离而不是全局唯一，理由跟 Category 一样——
/// 两个账号各自恢复同一份备份文件时，这两行的 name 会撞在一起。
///
/// 故意**不跟 Category 建外键**：图标的生命周期比分类长一截——换图之后旧文件还在、
/// 恢复时图先落地分类后写。建了外键，这两个顺序都得倒过来迁就它。
model CategoryIcon {
  name     String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType String
  /// 图片本体。Prisma 的 Bytes 映射成 Postgres 的 bytea，比存 base64 文本省三分之一
  data     Bytes
  /// 字节数。单独存一列是为了"这个账号占了多少空间"不用把每张图都读出来才数得出
  size      Int
  createdAt DateTime @default(now())

  @@id([userId, name])
}

model TransactionImage {
  id            String      @id @default(uuid())
  url           String // Cloudinary 图片地址
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model RecurringTransaction {
  id           String             @id
  title        String
  remarks      String?
  amount       Decimal
  currency     String             @default("MYR")
  exchangeRate Decimal            @default(1)
  type         TransactionType
  frequency    RecurringFrequency
  startDate    DateTime
  nextRunDate  DateTime // 下次该生成记录的日期，App打开时检查
  endDate      DateTime?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())

  categoryId String
  category   Category @relation(fields: [userId, categoryId], references: [userId, id])
  accountId  String
  account    Account  @relation(fields: [userId, accountId], references: [userId, id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedTransactions Transaction[]
}

model Transfer {
  id            String   @id
  amount        Decimal
  date          DateTime
  note          String?
  fromAccountId String
  fromAccount   Account  @relation("FromAccount", fields: [userId, fromAccountId], references: [userId, id])
  toAccountId   String
  toAccount     Account  @relation("ToAccount", fields: [userId, toAccountId], references: [userId, id])
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

/**
 * 手机端建的那张表，**不归后端管，但必须在这儿声明**。
 *
 * 它记的是"这个库的远端表结构跑到第几版了"——SQLite 有内置的 `user_version`，
 * Postgres 没有，所以手机那边（mobile/src/db/neon/schema.ts）自己建了一张。
 *
 * 后端一行都不读它。写在这里的唯一理由是：同一个库被两边共用时，
 * Prisma 看到一张自己不认识的表就会报 drift，并提议重置整个 schema——那会清库。
 * 声明出来，两边就对得上了。
 */
model app_meta {
  id            Int       @id
  schemaVersion Int       @default(0)
  bookId        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastPushAt    DateTime? @db.Timestamptz(6)
  lastPushApp   String?
}
